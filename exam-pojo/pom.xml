            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 添加对common模块的依赖 -->
        <dependency>
            <groupId>com.ant</groupId>
            <artifactId>exam-common</artifactId>
        </dependency>
